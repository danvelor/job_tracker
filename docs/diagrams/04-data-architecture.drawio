        <mxCell id="rules" value="&lt;b&gt;mapping rules&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748B'&gt;uuid primary keys generated in the domain · Address flattened as owned columns · enums as text with a CHECK · snake_case by convention · created_at and updated_at on every aggregate table · organization_id never nullable&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="70" y="890" width="1040" height="44" as="geometry"/></mxCell>
