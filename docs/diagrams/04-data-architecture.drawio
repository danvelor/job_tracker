        <mxCell id="job" value="&lt;b&gt;jobs.jobs&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748B'&gt;id  uuid  &lt;b&gt;PK&lt;/b&gt;&lt;br&gt;organization_id  uuid  not null&lt;br&gt;title  varchar(200) · description  text null&lt;br&gt;status  varchar(20)  check&lt;br&gt;street · city · state · zip_code  text&lt;br&gt;latitude · longitude  numeric(9,6)&lt;br&gt;scheduled_date  date null&lt;br&gt;started_at · completed_at · cancelled_at  timestamptz null&lt;br&gt;cancellation_reason · signature_url  text null&lt;br&gt;assignee_id  uuid null  &lt;b&gt;FK&lt;/b&gt;&lt;br&gt;customer_id  uuid not null  &lt;b&gt;FK&lt;/b&gt;&lt;br&gt;created_at · updated_at  timestamptz&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDE68A;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="380" y="330" width="420" height="200" as="geometry"/></mxCell>
