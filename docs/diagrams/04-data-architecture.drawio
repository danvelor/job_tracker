        <mxCell id="p2" value="2 · INDEXES — organization_id leads every tenant-scoped one" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#334155;align=left;verticalAlign=top;spacingLeft=16;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="1100" height="350" as="geometry"/></mxCell>
