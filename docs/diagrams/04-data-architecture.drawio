        <mxCell id="p1" value="1 · THE RELATIONAL MODEL — every foreign key stays inside the schema that owns both ends" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#334155;align=left;verticalAlign=top;spacingLeft=16;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1100" height="830" as="geometry"/></mxCell>
        <mxCell id="cust" value="&lt;b&gt;jobs.customers&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748B'&gt;id  uuid  &lt;b&gt;PK&lt;/b&gt;&lt;br&gt;organization_id  uuid&lt;br&gt;name  varchar(200)&lt;br&gt;email  varchar(320)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDE68A;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="70" y="170" width="250" height="100" as="geometry"/></mxCell>
