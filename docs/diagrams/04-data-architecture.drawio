        <mxCell id="lg1" value="one to many, mandatory" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="668" y="34" width="250" height="16" as="geometry"/></mxCell>
