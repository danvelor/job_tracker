<mxfile host="app.diagrams.net" agent="JobTracker" version="24.0.0">
  <diagram id="cross-cutting" name="Cross-cutting">
    <mxGraphModel dx="1422" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="&lt;b&gt;JobTracker — Cross-cutting concerns&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="760" height="32" as="geometry"/></mxCell>
        <mxCell id="t2" value="Assessment part 6.1 (5) — authentication, multi-tenancy, error handling" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="760" height="18" as="geometry"/></mxCell>
        <mxCell id="l1" style="html=1;endArrow=none;strokeWidth=1.4;strokeColor=#475569;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="34" as="sourcePoint"/><mxPoint x="652" y="34" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="al0" value="call or write" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="660" y="34" width="210" height="16" as="geometry"/></mxCell>
        <mxCell id="l2" style="html=1;endArrow=none;strokeWidth=1.4;strokeColor=#9F1239;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="56" as="sourcePoint"/><mxPoint x="652" y="56" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="al1" value="the failure path" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="660" y="56" width="210" height="16" as="geometry"/></mxCell>
        <mxCell id="tk0" value="" style="rounded=1;arcSize=30;html=1;fillColor=#FFFFFF;strokeColor=#FDE68A;" vertex="1" parent="1"><mxGeometry x="890" y="27" width="26" height="14" as="geometry"/></mxCell>
        <mxCell id="tl0" value="backend" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="924" y="34" width="240" height="16" as="geometry"/></mxCell>
        <mxCell id="tk1" value="" style="rounded=1;arcSize=30;html=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;" vertex="1" parent="1"><mxGeometry x="890" y="49" width="26" height="14" as="geometry"/></mxCell>
        <mxCell id="tl1" value="frontend" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="924" y="56" width="240" height="16" as="geometry"/></mxCell>
        <mxCell id="tk2" value="" style="rounded=1;arcSize=30;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="890" y="71" width="26" height="14" as="geometry"/></mxCell>
        <mxCell id="tl2" value="shared or test" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="924" y="78" width="240" height="16" as="geometry"/></mxCell>
        <mxCell id="p1" value="1 · AUTHENTICATION — the org claim is the whole point of it" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#334155;align=left;verticalAlign=top;spacingLeft=16;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1100" height="285" as="geometry"/></mxCell>
        <mxCell id="iss" value="&lt;b&gt;POST /auth/dev-token&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748B'&gt;mapped only when&lt;br&gt;Environment.IsDevelopment()&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDE68A;fontFamily=Helvetica;fontSize=11;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="70" y="165" width="250" height="78" as="geometry"/></mxCell>
        <mxCell id="tok" value="&lt;b&gt;TokenIssuer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748B'&gt;HS256, symmetric key from&lt;br&gt;configuration · claims sub · org · name&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDE68A;fontFamily=Helvetica;fontSize=11;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="350" y="165" width="250" height="78" as="geometry"/></mxCell>
        <mxCell id="cache" value="&lt;b&gt;infrastructure/api/token&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748B'&gt;cached for the Next process,&lt;br&gt;server-side — never in the browser&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;fontFamily=Helvetica;fontSize=11;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="630" y="165" width="230" height="78" as="geometry"/></mxCell>
        <mxCell id="hdr" value="&lt;b&gt;HttpJobsAdapter&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748B'&gt;Authorization: Bearer …&lt;br&gt;on every request&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;fontFamily=Helvetica;fontSize=11;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="890" y="165" width="220" height="78" as="geometry"/></mxCell>
        <mxCell id="val" value="&lt;b&gt;JwtBearer validation&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748B'&gt;issuer · audience · lifetime&lt;br&gt;· signing key, all validated&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDE68A;fontFamily=Helvetica;fontSize=11;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="890" y="285" width="220" height="78" as="geometry"/></mxCell>
        <mxCell id="ctx" value="&lt;b&gt;HttpTenantContext&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748B'&gt;reads the org claim off the&lt;br&gt;validated principal → ITenantContext&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDE68A;fontFamily=Helvetica;fontSize=11;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="610" y="285" width="250" height="78" as="geometry"/></mxCell>
        <mxCell id="retry" value="&lt;b&gt;a 401 is a stale token first&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748B'&gt;the adapter refreshes once and retries the request exactly once; a second refusal is reported — the cache outlives the hour-long token&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDA4AF;fontFamily=Helvetica;fontSize=11;fontColor=#9F1239;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="70" y="285" width="500" height="78" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#475569;strokeWidth=1.2;endArrow=blockThin;endFill=1;fontFamily=Helvetica;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="iss" target="tok"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#475569;strokeWidth=1.2;endArrow=blockThin;endFill=1;fontFamily=Helvetica;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tok" target="cache"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#475569;strokeWidth=1.2;endArrow=blockThin;endFill=1;fontFamily=Helvetica;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cache" target="hdr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#475569;strokeWidth=1.2;endArrow=blockThin;endFill=1;fontFamily=Helvetica;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="hdr" target="val"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#475569;strokeWidth=1.2;endArrow=blockThin;endFill=1;fontFamily=Helvetica;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="val" target="ctx"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="401" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#9F1239;strokeWidth=1.2;endArrow=blockThin;endFill=1;fontFamily=Helvetica;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="val" target="retry"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="refresh" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#9F1239;strokeWidth=1.2;endArrow=blockThin;endFill=1;fontFamily=Helvetica;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="retry" target="cache"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2" value="2 · MULTI-TENANCY — four layers, in the order they catch a mistake" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#334155;align=left;verticalAlign=top;spacingLeft=16;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="445" width="1100" height="320" as="geometry"/></mxCell>
        <mxCell id="l0" value="&lt;b&gt;1 · middleware&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748B'&gt;HttpTenantContext resolves ITenantContext from the validated org claim · a request without one cannot reach a handler&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDE68A;fontFamily=Helvetica;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="70" y="490" width="1040" height="56" as="geometry"/></mxCell>
        <mxCell id="l1" value="&lt;b&gt;2 · EF global query filter&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748B'&gt;HasQueryFilter(e =&amp;gt; e.OrganizationId == OrganizationId) on Job, Assignee, Customer, Notification · a query written with no tenant condition still cannot return another org's rows&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDE68A;fontFamily=Helvetica;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="70" y="556" width="1040" height="56" as="geometry"/></mxCell>
        <mxCell id="l2" value="&lt;b&gt;3 · the aggregate&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748B'&gt;Job requires organizationId at creation and exposes no setter, so a job cannot be moved between tenants&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDE68A;fontFamily=Helvetica;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="70" y="622" width="1040" height="56" as="geometry"/></mxCell>
        <mxCell id="l3" value="&lt;b&gt;4 · ArchitectureTests&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748B'&gt;TenantRules asserts every ITenantScoped entity has a query filter configured, and that nothing else does — adding a table cannot silently omit the protection&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontFamily=Helvetica;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="70" y="688" width="1040" height="56" as="geometry"/></mxCell>
        <mxCell id="tnote" value="layer 2 does the work · layers 1, 3 and 4 exist so that a mistake in it is caught rather than exploited" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="70" y="748" width="1040" height="14" as="geometry"/></mxCell>
        <mxCell id="p3" value="3 · ERROR HANDLING — an expected failure is a value, and it keeps its meaning across the wire" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#334155;align=left;verticalAlign=top;spacingLeft=16;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="805" width="1100" height="440" as="geometry"/></mxCell>
        <mxCell id="agg" value="&lt;b&gt;Job.Complete(…)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748B'&gt;an invariant refuses:&lt;br&gt;Result.Failure(JobErrors.…)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDE68A;fontFamily=Helvetica;fontSize=11;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="70" y="855" width="240" height="66" as="geometry"/></mxCell>
        <mxCell id="res" value="&lt;b&gt;Result&amp;lt;T&amp;gt; · Error&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748B'&gt;code · message · type&lt;br&gt;no exception is thrown&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDE68A;fontFamily=Helvetica;fontSize=11;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="340" y="855" width="240" height="66" as="geometry"/></mxCell>
        <mxCell id="map" value="&lt;b&gt;ResultExtensions&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748B'&gt;Common.Presentation maps&lt;br&gt;the error type to a status&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDE68A;fontFamily=Helvetica;fontSize=11;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="610" y="855" width="240" height="66" as="geometry"/></mxCell>
        <mxCell id="pd" value="&lt;b&gt;ProblemDetails&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748B'&gt;the HTTP body the endpoint returns&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDE68A;fontFamily=Helvetica;fontSize=11;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="880" y="855" width="230" height="66" as="geometry"/></mxCell>
        <mxCell id="tbl" value="&lt;b&gt;type → status&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748B'&gt;Validation → 400&lt;br&gt;NotFound → 404&lt;br&gt;Conflict → 409&lt;br&gt;Unauthorized → 401&lt;br&gt;Failure → 500&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="880" y="945" width="230" height="108" as="geometry"/></mxCell>
        <mxCell id="adp" value="&lt;b&gt;HttpJobsAdapter&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748B'&gt;maps ProblemDetails back&lt;br&gt;into a CoreError&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;fontFamily=Helvetica;fontSize=11;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="610" y="1075" width="240" height="66" as="geometry"/></mxCell>
        <mxCell id="core" value="&lt;b&gt;the same vocabulary&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748B'&gt;core sees one failure shape&lt;br&gt;whichever adapter is selected&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;fontFamily=Helvetica;fontSize=11;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="340" y="1075" width="240" height="66" as="geometry"/></mxCell>
        <mxCell id="ui1" value="&lt;b&gt;app/jobs/error.tsx&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748B'&gt;route boundary · retry via reset()&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;fontFamily=Helvetica;fontSize=11;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="70" y="1075" width="240" height="66" as="geometry"/></mxCell>
        <mxCell id="ui2" value="&lt;b&gt;jobs-error-boundary&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748B'&gt;wraps the table so one render&lt;br&gt;failure does not blank the page&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;fontFamily=Helvetica;fontSize=11;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="70" y="1165" width="240" height="56" as="geometry"/></mxCell>
        <mxCell id="exc" value="&lt;b&gt;exceptions are for defects, not for expected failures&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#64748B'&gt;a thrown exception means a bug · an invariant refusing an operation does not&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDA4AF;fontFamily=Helvetica;fontSize=11;fontColor=#9F1239;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="340" y="1165" width="510" height="56" as="geometry"/></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#475569;strokeWidth=1.2;endArrow=blockThin;endFill=1;fontFamily=Helvetica;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="agg" target="res"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#475569;strokeWidth=1.2;endArrow=blockThin;endFill=1;fontFamily=Helvetica;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="res" target="map"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#475569;strokeWidth=1.2;endArrow=blockThin;endFill=1;fontFamily=Helvetica;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="map" target="pd"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;strokeColor=#475569;strokeWidth=1.2;endArrow=blockThin;endFill=1;fontFamily=Helvetica;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pd" target="tbl"><mxGeometry relative="1" as="geometry"/></mxCell>
