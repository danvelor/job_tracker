<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\JobTracker.Modules.Jobs.Domain\JobTracker.Modules.Jobs.Domain.csproj" />
    <ProjectReference Include="..\..\..\Common\JobTracker.Common.Application\JobTracker.Common.Application.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <ItemGroup>
    <!-- Handlers are internal because nothing outside the module may invoke
         one directly; MediatR resolves them by contract (architecture 9.1).
         That modifier is doing real work, so it stays — and the unit tests get
         an explicit grant rather than the handlers being widened to public for
         the convenience of the test project. -->
    <InternalsVisibleTo Include="JobTracker.Modules.Jobs.Application.UnitTests" />
    <InternalsVisibleTo Include="JobTracker.IntegrationTests" />
  </ItemGroup>
</Project>
