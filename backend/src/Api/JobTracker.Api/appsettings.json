{
  "Jwt": {
    "Issuer": "jobtracker",
    "Audience": "jobtracker",
    "LifetimeMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "SegmentsPerWindow": 6
  },
  "Database": {
    "MigrateOnStartup": false
  }
}
